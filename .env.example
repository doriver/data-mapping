MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=data04

# 브이월드(vworld.kr) 다운로드는 로그인 세션이 있어야 한다.
# 브라우저에서 로그인 후 개발자도구(F12) > Network 탭에서 요청의 Cookie 헤더 전체 값을 복사해 붙여넣는다.
# (PJSESSIONID 등 세션 쿠키라 시간이 지나면 만료되므로, 요청이 실패하면 다시 로그인 후 갱신해야 한다)
VWORLD_COOKIE=

# 파이퍼(manage.namo.ai.kr) 관리자 계정. 로그인 API로 Bearer 토큰(12시간 유효)을 받아 사용한다.
PIPER_LOGIN_ID=
PIPER_LOGIN_PASSWORD=
